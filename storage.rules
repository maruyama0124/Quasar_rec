rules_version = '2';

// 子ども食堂イベント版 謎解きアプリ Storage セキュリティルール（厳格）
// - 匿名認証必須
// - photos/{teamKey}/{slot} のみ。teamKeyは既知6チーム、slotは 0〜3
// - 画像のみ・1MB以下に制限
// - その他のパスは全拒否
service firebase.storage {
  match /b/{bucket}/o {

    function knownTeam(id) {
      return id in ['risa', 'tsubasa', 'muta', 'koharu', 'eito', 'shiori'];
    }

    match /photos/{teamKey}/{slot} {
      allow read: if request.auth != null && knownTeam(teamKey);
      allow write: if request.auth != null
        && knownTeam(teamKey)
        && slot.matches('[0-3]\\.jpg')
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 1 * 1024 * 1024;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
